\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Coasting KV reference for $2.5\,\mathrm  {MeV}$ protons with geometric rms emittances of $3\times 10^{-6}\,\mathrm  {m\,rad}$ in each plane. The full positive tunes $Q_x$ and $Q_y$ follow from the numerically matched periodic envelopes. The final row is envelope-unstable and serves only as a stress case.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:operating-points}{{2}{7}{Coasting KV reference for $2.5\units {MeV}$ protons with geometric rms emittances of $3\times 10^{-6}\units {m\,rad}$ in each plane. The full positive tunes $Q_x$ and $Q_y$ follow from the numerically matched periodic envelopes. The final row is envelope-unstable and serves only as a stress case}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Incoherent KV tune shifts versus total coasting ring charge for the baseline $2.5\,\mathrm  {MeV}$ proton lattice, with geometric rms emittances of $3\times 10^{-6}\,\mathrm  {m\,rad}$ in both planes and zero momentum spread. The curves join the saved periodic-envelope solutions for $\Delta Q_x$ and $\Delta Q_y$; circles mark the operating points in Table~\ref {tab:operating-points}, and crosses mark envelope-unstable samples. The dotted line identifies the principal comparison point, $Q_{\mathrm  {ring}}=12.268\,\mathrm  {nC}$, where $\Delta Q_y=-0.2$. The self-fields are analytic, while envelope matching and phase integration are numerical. These curves are independent references, not FFT2D5 tracking results.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:kv-tune-shift-charge}{{2}{7}{Incoherent KV tune shifts versus total coasting ring charge for the baseline $2.5\units {MeV}$ proton lattice, with geometric rms emittances of $3\times 10^{-6}\units {m\,rad}$ in both planes and zero momentum spread. The curves join the saved periodic-envelope solutions for $\Delta Q_x$ and $\Delta Q_y$; circles mark the operating points in Table~\ref {tab:operating-points}, and crosses mark envelope-unstable samples. The dotted line identifies the principal comparison point, $Q_{\mathrm {ring}}=12.268\units {nC}$, where $\Delta Q_y=-0.2$. The self-fields are analytic, while envelope matching and phase integration are numerical. These curves are independent references, not FFT2D5 tracking results}{figure.2}{}}
